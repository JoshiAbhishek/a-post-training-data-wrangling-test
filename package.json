{
  "name": "post-training-data-wrangling",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed JSON DSL for text reformatting, and LLM program synthesis from examples",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/table",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:py",
    "synth:table": "node src/table/synth.ts",
    "tasks:coverage": "node src/eval/coverage.ts",
    "eval": "node src/eval/cli.ts",
    "test:py": "python3 -m unittest discover -s scripts -p \"test_*.py\""
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
